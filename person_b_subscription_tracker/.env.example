# ============================================================
# Person B - Subscription Renewal & Cost Tracker
# Copy this file to `.env` and adjust values. NEVER commit the
# real `.env` file. This file contains PLACEHOLDERS ONLY.
# ============================================================

# --- Service identity ---
SERVICE_NAME=subscription-cost-tracker
APP_PORT=8002

# --- Database (local SQLite; each project uses its OWN file) ---
# Relative sqlite paths resolve against this project folder (any OS).
DATABASE_URL=sqlite:///data/subscriptions.db
# PostgreSQL (e.g. Render Postgres; postgres:// is accepted and normalized):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Frontend (Streamlit) ---
API_BASE_URL=http://127.0.0.1:8002
